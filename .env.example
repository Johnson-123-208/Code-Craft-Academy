# CodeCraft Academy – environment variables
# Copy to .env and adjust as needed.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CodeCraft Academy
# Use Pyodide (WASM) client-side runner when Docker sandbox is unavailable
NEXT_PUBLIC_USE_PYODIDE=false

# Backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CONTENT_DIR=/app/content
RATE_LIMIT=30/minute
MAX_REQUEST_SIZE_BYTES=65536

# Code execution sandbox
SANDBOX_IMAGE=codecraft-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=256
SANDBOX_PIDS_LIMIT=64
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_NETWORK=none
# Set to true to skip Docker and return a stub (local UI-only development)
SANDBOX_DISABLED=false
