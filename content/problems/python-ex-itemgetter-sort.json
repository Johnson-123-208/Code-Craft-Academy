  "statement": "Implement `solve(rows, index)`. Each row is a list of integers. Return the rows sorted by the value at `index`, ascending. If any row is too short, return `error`. Do not catch IndexError and skip the row.\n",
  "constraints": [
    "All rows must be long enough",
    "Sort is ascending"
  ],
  "examples": [
    {
      "input": "rows = [[2, 1], [1, 9], [1, 0]], index = 0",
      "output": "[[1, 9], [1, 0], [2, 1]]"
    },
    {
      "input": "rows = [[1]], index = 1",
      "output": "\"error\""
    }
  ],
  "starter_code": "def solve(rows, index):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "Check lengths first.",
    "Then sorted with a key on that index.",
    "Copy each row into the result."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n log n)",
        "space": "O(n)"
      },
      "explanation": "operator."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
        "rows": [
          [
            2,
            1
          ],
          [
            1,
            9
          ],
          [
            1,
            0
          ]
        ],
        "index": 0
      },
      "expected": [
