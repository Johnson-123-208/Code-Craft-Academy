  "statement": "Implement `solve(text)`. Return the number of bytes in the UTF-8 encoding of `text`. Do not change the text. The string length in code points is not the answer when a character needs more than one byte.\n",
  "constraints": [
    "Encode as utf-8",
    "Return an integer byte count"
  ],
  "examples": [
    {
      "input": "text = \"abc\"",
      "output": "3"
    },
    {
      "input": "text = \"\\u00e9\"",
      "output": "2"
    }
  ],
  "starter_code": "def solve(text):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "text.encode('utf-8') produces the bytes.",
    "len of those bytes is the size.",
    "An empty string is 0 bytes."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "explanation": "len(text) counts code points."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
        "text": "abc"
      },
      "expected": 3
    },
    {
