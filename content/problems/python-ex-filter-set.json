  "statement": "Implement `solve(left, right)`. Return the items from `left` that appear in `right`, in `left`'s order. Duplicates in `left` are kept when the value is allowed. Build a set from `right` for the membership test.\n",
  "constraints": [
    "Order follows left",
    "right is a membership set"
  ],
  "examples": [
    {
      "input": "left = [\"a\", \"b\", \"a\"], right = [\"a\"]",
      "output": "[\"a\", \"a\"]"
    },
    {
      "input": "left = [\"a\"], right = []",
      "output": "[]"
    }
  ],
  "starter_code": "def solve(left, right):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "set(right) once.",
    "Walk left and keep hits.",
    "Do not sort."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n + m)",
        "space": "O(m)"
      },
      "explanation": "A nested scan is quadratic."
    }
  ],
  "visible_tests": [
