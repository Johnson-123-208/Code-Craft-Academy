  "statement": "Implement `solve(domain, cause)`. Return `{\"error\": domain, \"cause\": cause}`. Translating a low-level failure into a domain word must keep the original tag. Dropping `cause` is the bug this function refuses.\n",
  "constraints": [
    "Both inputs are strings",
    "Both appear in the result"
  ],
  "examples": [
    {
      "input": "domain = \"BillingError\", cause = \"timeout\"",
      "output": "{\"error\": \"BillingError\", \"cause\": \"timeout\"}"
    },
    {
      "input": "domain = \"NotFound\", cause = \"FileNotFoundError\"",
      "output": "{\"error\": \"NotFound\", \"cause\": \"FileNotFoundError\"}"
    }
  ],
  "starter_code": "def solve(domain, cause):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "Put the domain word under error.",
    "Put the original tag under cause.",
    "Do not return only the domain word."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(1)",
        "space": "O(1)"
      },
      "explanation": "raise DomainError(."
    }
  ],
  "visible_tests": [
