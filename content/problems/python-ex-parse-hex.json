  "statement": "Implement `solve(text)`. Parse `text` as base 16 and return the integer. A bad string returns `error`. An empty string is an error. The prefix 0x is not allowed. Use int(text, 16).\n",
  "constraints": [
    "Base 16 only",
    "No 0x prefix"
  ],
  "examples": [
    {
      "input": "text = \"ff\"",
      "output": "255"
    },
    {
      "input": "text = \"0\"",
      "output": "0"
    }
  ],
  "starter_code": "def solve(text):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "int(text, 16) inside try.",
    "Catch ValueError.",
    "Return the integer on success."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "explanation": "functools."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
        "text": "ff"
      },
      "expected": 255
    },
    {
      "name": "case-2",
      "args": {
        "text": "0"
