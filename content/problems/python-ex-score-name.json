  "statement": "Implement `solve(rows)`. `rows` is a list of `[name, score]`. Return the rows sorted by score descending, then by name ascending. Use one tuple key. Do not sort twice unless the directions are both ascending after you transform the score.\n",
  "constraints": [
    "Higher score comes first",
    "Names break ties ascending"
  ],
  "examples": [
    {
      "input": "rows = [[\"ada\", 10], [\"grace\", 12], [\"lin\", 12]]",
      "output": "[[\"grace\", 12], [\"lin\", 12], [\"ada\", 10]]"
    },
    {
      "input": "rows = [[\"b\", 1], [\"a\", 1]]",
      "output": "[[\"a\", 1], [\"b\", 1]]"
    }
  ],
  "starter_code": "def solve(rows):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "The key (-score, name) sorts ascending into the order you want.",
    "Negating the score is what flips that field.",
    "Return copies of the rows in the sorted order."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n log n)",
        "space": "O(n)"
      },
      "explanation": "sorted is ascending."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
