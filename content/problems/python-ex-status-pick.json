  "statement": "Implement `solve(situation)`. Map `fetched` to 200, `created` to 201, `deleted` to 204, `missing` to 404, and `conflict` to 409. Any other word returns 500.\n",
  "constraints": [
    "deleted is 204, not 200",
    "Unknown is 500"
  ],
  "examples": [
    {
      "input": "situation = \"created\"",
      "output": "201"
    },
    {
      "input": "situation = \"deleted\"",
      "output": "204"
    }
  ],
  "starter_code": "def solve(situation):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "Use a dict.",
    "Default to 500.",
    "Return an integer."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(1)",
        "space": "O(1)"
      },
      "explanation": "Clients and monitors branch on status codes."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
        "situation": "created"
      },
      "expected": 201
    },
    {
      "name": "case-2",
