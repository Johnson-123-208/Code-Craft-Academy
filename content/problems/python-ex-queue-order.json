  "statement": "Implement `solve(ops)`. Ops are `[\"enq\", value]` or `[\"deq\"]`. Use a deque. Return the list of dequeued integers. A dequeue on an empty deque records nothing and is skipped. Values are integers.\n",
  "constraints": [
    "FIFO order",
    "Empty dequeue is a no-op"
  ],
  "examples": [
    {
      "input": "ops = [[\"enq\", 1], [\"enq\", 2], [\"deq\"], [\"deq\"]]",
      "output": "[1, 2]"
    },
    {
      "input": "ops = [[\"deq\"], [\"enq\", 3], [\"deq\"]]",
      "output": "[3]"
    }
  ],
  "starter_code": "def solve(ops):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "append and popleft.",
    "Skip empty pops.",
    "Return only the popped values."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "explanation": "list."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
        "ops": [
          [
            "enq",
            1
          ],
          [
            "enq",
            2
          ],
          [
            "deq"
          ],
          [
            "deq"
          ]
        ]
      },
      "expected": [
