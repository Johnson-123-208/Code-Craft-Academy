  "statement": "Implement `solve(name, new_name)`. Return `{\"old\": name, \"new\": new_name}`. Replacing a field on a frozen record returns a new record and leaves the old name in place. Do not overwrite `name`.\n",
  "constraints": [
    "Both names are returned",
    "old is the original argument"
  ],
  "examples": [
    {
      "input": "name = \"ada\", new_name = \"grace\"",
      "output": "{\"old\": \"ada\", \"new\": \"grace\"}"
    },
    {
      "input": "name = \"ada\", new_name = \"ada\"",
      "output": "{\"old\": \"ada\", \"new\": \"ada\"}"
    }
  ],
  "starter_code": "def solve(name, new_name):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "Echo name as old.",
    "Echo new_name as new.",
    "Do not return only the new name."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(1)",
        "space": "O(1)"
      },
      "explanation": "dataclasses."
    }
  ],
  "visible_tests": [
    {
      "name": "case-1",
      "args": {
        "name": "ada",
        "new_name": "grace"
      },
      "expected": {
        "old": "ada",
        "new": "grace"
      }
    },
    {
      "name": "case-2",
      "args": {
        "name": "ada",
        "new_name": "ada"
      },
      "expected": {
        "old": "ada",
        "new": "ada"
      }
    }
  ],
  "hidden_tests": [
    {
      "name": "case-3",
      "args": {
        "name": "",
        "new_name": "a"
      },
      "expected": {
        "old": "",
        "new": "a"
      }
    },
    {
      "name": "case-4",
      "args": {
        "name": "a",
        "new_name": ""
      },
      "expected": {
        "old": "a",
        "new": ""
      }
    }
  ],
  "editorial": "dataclasses.replace builds a new instance with the listed fields changed. The original object stays. Tests that only look at the new value miss a mutation of the old one. Returning both names makes the copy obvious.",
  "reference_solution": "def solve(name, new_name):\n    old = {\"name\": name}\n    updated = {\"name\": new_name}\n    return {\"old\": old[\"name\"], \"new\": updated[\"name\"]}\n"
}
