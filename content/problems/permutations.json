  "statement": "Return every permutation of distinct integers `nums`. Sort the list of permutations lexicographically.\n",
  "constraints": [
    "1 <= nums.length <= 6",
    "All values are distinct"
  ],
  "function_name": "permute",
  "hints": [
    "Swap the current index with each later index, recurse, then swap back.",
    "A used array also works: choose any unused value at the next depth.",
    "There are n! leaves. The work is proportional to n times that, because each leaf copies a list of length n."
  ],
  "approaches": [
    {
      "name": "Library enumeration",
      "complexity": {
        "time": "O(n * n!)",
        "space": "O(n)"
      },
      "explanation": "Fine as an oracle, not as the interview answer."
    },
    {
      "name": "Backtracking with swaps or a used set",
      "complexity": {
        "time": "O(n * n!)",
        "space": "O(n)"
      },
      "explanation": "Depth n, branching n, n-1, and so on."
    }
  ],
  "editorial": "At depth d the path has d chosen values. The next value is any value not yet chosen. Mark it, recurse, and unmark it. Copy the path when its length is n. Sorting the collected permutations makes the answer deterministic.",
  "reference_solution": "from typing import Dict, List, Optional, Tuple\nfrom collections import Counter, OrderedDict, defaultdict, deque\nimport heapq\n\ndef permute(nums: list[int]) -> list[list[int]]:\n    out: list[list[int]] = []\n    path: list[int] = []\n    used = [False] * len(nums)\n\n    def dfs() -> None:\n        if len(path) == len(nums):\n            out.append(path[:])\n            return\n        for i, value in enumerate(nums):\n            if used[i]:\n                continue\n            used[i] = True\n            path.append(value)\n            dfs()\n            path.pop()\n            used[i] = False\n\n    dfs()\n    out.sort()\n    return out\n",
  "starter_code": "from typing import List\n\ndef permute(nums: List[int]) -> List[List[int]]:\n    pass\n",
