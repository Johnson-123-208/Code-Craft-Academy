  "statement": "Implement `solve(parts)`. Join the strings with a comma. An empty list returns an empty string. Do not leave a trailing comma.\n",
  "constraints": [
    "Comma between parts only",
    "Empty input is empty"
  ],
  "examples": [
    {
      "input": "parts = [\"a\", \"b\", \"c\"]",
      "output": "\"a,b,c\""
    },
    {
      "input": "parts = []",
      "output": "\"\""
    }
  ],
  "starter_code": "def solve(parts):\n    pass\n",
  "function_name": "solve",
  "hints": [
    "Use str.join.",
    "Do not append commas in a loop and then strip one.",
    "One separator rule."
  ],
  "approaches": [
    {
      "name": "Direct",
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "explanation": "Repeated concatenation copies a growing string."
    }
  ],
  "visible_tests": [
